# App
PORT=3001
NODE_ENV=development

# Process role: all (default, monolith — web also runs the sync worker) |
# web (API only) | worker (sync processor only, no HTTP). Split web+worker
# for horizontal scale: run `node dist/main` (ROLE=web) and
# `node dist/worker` (ROLE=worker).
# Split deployments set this PER PROCESS at launch, not here:
#   web    -> ROLE=web    node dist/main
#   worker -> ROLE=worker node dist/worker
ROLE=all
# Concurrent repo syncs per worker process. Keep at 1 unless distributed
# rate limiting is enabled (RATE_LIMITER=redis).
SYNC_CONCURRENCY=1

# AI rate limiter: memory (default, per-process) | redis (distributed,
# required when running >1 worker or SYNC_CONCURRENCY>1).
RATE_LIMITER=memory
# Min ms between calls per provider (defaults match the original values).
KILO_MIN_INTERVAL_MS=400
GEMINI_MIN_INTERVAL_MS=800
# Optional coarse Bull cap: at most SYNC_RATE_MAX jobs per
# SYNC_RATE_DURATION_MS. Unset = no cap.
# SYNC_RATE_MAX=10
# SYNC_RATE_DURATION_MS=1000

# Ingestion cost reduction (Phase 3), both default off = today's behavior.
# AI_COMBINED_ANALYSIS=on collapses 3 LLM calls/commit into 1 (per-field
# fallback on parse failure, so never worse).
AI_COMBINED_ANALYSIS=on
# INCREMENTAL_SYNC=on enables GitHub conditional ETag fetch + `since` +
# Link pagination (lifts the 100-commit cap, bounded by MAX_COMMITS_PER_SYNC).
INCREMENTAL_SYNC=on
MAX_COMMITS_PER_SYNC=500

# Sync status transport (Phase 4): poll (default, frontend polls every 2s) |
# sse (push progress over Redis pub/sub to an SSE endpoint). When sse, the
# frontend must ALSO set NEXT_PUBLIC_STATUS_TRANSPORT=sse (and be rebuilt);
# it auto-falls back to polling on any stream error.
STATUS_TRANSPORT=sse

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=changelog_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=your_64_char_hex_jwt_secret_here
JWT_EXPIRES_IN=7d

# Session (OAuth state / CSRF). MUST be different from JWT_SECRET.
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_64_char_hex_session_secret_here

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# KILO CODE
KILOCODE_API_KEY=your_k..._key
KILOCODE_MODEL=nvidia/nemotron-3-super-120b-a12b:free  # free models: nvidia/nemotron-3-super-120b-a12b:free, deepseek/deepseek-v4-flash:free, baidu/cobuddy:free

# Frontend
FRONTEND_URL=http://localhost:3000
