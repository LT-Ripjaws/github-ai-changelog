# App
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=changelog_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=your_64_char_hex_jwt_secret_here
JWT_EXPIRES_IN=7d

# Session (OAuth state / CSRF). MUST be different from JWT_SECRET.
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_64_char_hex_session_secret_here

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# KILO CODE
KILOCODE_API_KEY=your_k..._key
KILOCODE_MODEL=nvidia/nemotron-3-super-120b-a12b:free  # free models: nvidia/nemotron-3-super-120b-a12b:free, deepseek/deepseek-v4-flash:free, baidu/cobuddy:free

# Frontend
FRONTEND_URL=http://localhost:3000
