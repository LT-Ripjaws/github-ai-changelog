NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001

# Sync status transport (Phase 4): poll (default, 2s polling) | sse (live
# push, auto-falls back to poll on error). Set to sse ONLY together with the
# backend's STATUS_TRANSPORT=sse. Changing this requires a frontend rebuild.
NEXT_PUBLIC_STATUS_TRANSPORT=sse
